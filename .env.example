# ==========================================================================
# Cesamar — variáveis de ambiente do ROBÔ (Cloud Run). Copie para .env só em
# testes locais; na nuvem cadastre no Cloud Run / Secret Manager.
# NUNCA coloque estas chaves no frontend nem no Git.
# ==========================================================================

# Fonte de tarifas: demo | amadeus | duffel | skyscanner
FLIGHT_PROVIDER=demo

# Onde o robô guarda os dados: json (local) | supabase (nuvem)
ROBO_ARMAZENAMENTO=json
ROBO_ARQUIVO=robo/dados/banco.json

# Supabase (Project Settings > API)
SUPABASE_URL=
# chave pública — pode ir para o frontend (protegida pelas regras RLS)
SUPABASE_ANON_KEY=
# chave de serviço — SÓ no servidor (ignora RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Provedores reais (preencher apenas o escolhido)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
DUFFEL_ACCESS_TOKEN=
SKYSCANNER_API_KEY=

# WhatsApp da central (com DDI e DDD, só números) — o painel pode sobrescrever
WHATSAPP_NUMERO=
